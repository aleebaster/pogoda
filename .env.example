# Telegram bot runtime only. Do not expose these to the browser.
TELEGRAM_BOT_TOKEN=
CHAT_ID=

# Local-only AI. Leave empty on Vercel.
LM_STUDIO_URL=
LM_STUDIO_MODEL=qwen2.5-7b-instruct

# Optional production AI fallback. App works without it.
OPENAI_API_KEY=

# Optional maps integration. Route buttons use public Google Maps URLs without this key.
MAPS_API_KEY=
